{
  "name": "flexorch-sdk",
  "version": "0.3.1",
  "description": "TypeScript/JavaScript SDK for the FlexOrch API — process documents, build LLM-ready datasets",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "llm",
    "dataset",
    "document",
    "pipeline",
    "flexorch",
    "pii",
    "rag"
  ],
  "author": "Flexorch Technology",
  "license": "MIT",
  "homepage": "https://flexorch.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/flexorch/flexorch-sdk-js"
  },
  "bugs": {
    "url": "https://github.com/flexorch/flexorch-sdk-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0"
  }
}
